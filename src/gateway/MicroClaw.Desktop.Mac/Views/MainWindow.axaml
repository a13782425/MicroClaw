<shadui:Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:desktopViews="using:MicroClaw.Desktop.Views"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    mc:Ignorable="d"
    d:DesignWidth="1164"
    d:DesignHeight="768"
    x:Class="MicroClaw.Desktop.Mac.Views.MainWindow"
    Width="1164"
    Height="768"
    MinWidth="980"
    MinHeight="640"
    Background="{DynamicResource WindowBackgroundColor}"
    ExtendClientAreaToDecorationsHint="True"
    Icon="avares://MicroClaw.Desktop/Assets/icon.ico"
    IsTitleBarVisible="False"
    RootCornerRadius="10"
    SaveWindowState="False"
    ShowBottomBorder="False"
    ShowTitlebarBackground="False"
    Title="MicroClaw"
    TitleBarAnimationEnabled="False"
    TransparencyLevelHint="Transparent"
    WindowDecorations="None"
    WindowStartupLocation="CenterScreen">

    <Grid ColumnDefinitions="242,*" ClipToBounds="True">
        <desktopViews:MainView Grid.ColumnSpan="2" />

        <Grid
            Grid.ColumnSpan="2"
            ColumnDefinitions="Auto,Auto,*"
            Height="44"
            Margin="16,0,12,0"
            VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Width="13" Height="13" Padding="0" Background="Transparent" BorderThickness="0" Click="OnCloseClicked" ToolTip.Tip="关闭">
                    <Ellipse Width="12" Height="12" Fill="#FF5F57" Stroke="#E0443E" StrokeThickness="0.5" />
                </Button>
                <Button Width="13" Height="13" Padding="0" Background="Transparent" BorderThickness="0" Click="OnMinimizeClicked" ToolTip.Tip="最小化">
                    <Ellipse Width="12" Height="12" Fill="#FFBD2E" Stroke="#DEA123" StrokeThickness="0.5" />
                </Button>
                <Button Width="13" Height="13" Padding="0" Background="Transparent" BorderThickness="0" Click="OnToggleZoomClicked" ToolTip.Tip="缩放">
                    <Ellipse Width="12" Height="12" Fill="#28C840" Stroke="#1EA034" StrokeThickness="0.5" />
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="24,0,0,0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center" PointerPressed="OnChromePointerPressed">
                <PathIcon Data="{x:Static shadui:Icons.SidePanel}" Width="13" Height="13" Foreground="{DynamicResource MutedColor}" />
                <PathIcon Data="{x:Static shadui:Icons.ChevronLeft}" Width="12" Height="12" Foreground="{DynamicResource MutedColor}" />
                <PathIcon Data="{x:Static shadui:Icons.ChevronRight}" Width="12" Height="12" Foreground="{DynamicResource MutedColor}" />
            </StackPanel>

            <Border Grid.Column="2" Background="Transparent" PointerPressed="OnChromePointerPressed" />
        </Grid>
    </Grid>
</shadui:Window>
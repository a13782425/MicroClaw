<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:monoGame="using:AvaloniaInside.MonoGame"
    xmlns:vm="using:MicroClaw.Desktop.ViewModels"
    mc:Ignorable="d"
    d:DesignWidth="668"
    d:DesignHeight="200"
    x:Class="MicroClaw.Desktop.Views.SessionGameTabView"
    x:DataType="vm:SessionGameTabViewModel"
    x:CompileBindings="True">

    <Border CornerRadius="10" ClipToBounds="True" Height="200" Width="668" Margin="0,52,0,0" VerticalAlignment="Top">
        <monoGame:MonoGameControl Game="{Binding PongGame}" />
    </Border>

</UserControl>

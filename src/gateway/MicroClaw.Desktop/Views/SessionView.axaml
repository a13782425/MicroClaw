<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MicroClaw.Desktop.ViewModels"
    xmlns:desktop="using:MicroClaw.Desktop"
    mc:Ignorable="d"
    d:DesignWidth="900"
    d:DesignHeight="700"
    x:Class="MicroClaw.Desktop.Views.SessionView"
    x:DataType="vm:SessionViewModel"
    x:CompileBindings="True">

    <Grid RowDefinitions="*,Auto">

        <!-- Content area — routed via ContentControl + ViewLocator.
             Each tab page manages its own scrolling and width. -->
        <ContentControl
            Grid.Row="0"
            Content="{Binding CurrentTabPage}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />

        <!-- Bottom tab bar -->
        <Border
            Grid.Row="1"
            HorizontalAlignment="Center"
            Margin="0,8,0,16"
            Background="{DynamicResource MutedColor}"
            CornerRadius="10"
            Padding="3">
            <StackPanel Orientation="Horizontal" Spacing="2">

                <!-- 聊天 tab -->
                <Grid Width="80" Height="32">
                    <Border
                        CornerRadius="8"
                        Background="{DynamicResource WindowBackgroundColor}"
                        IsVisible="{Binding IsChatTabActive}" />
                    <Button
                        Classes="Ghost"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Command="{Binding NavigateTabCommand}"
                        CommandParameter="{x:Static desktop:PageRouteDefine.RouteSessionChat}">
                        <TextBlock Text="聊天" Classes="Caption" />
                    </Button>
                </Grid>

                <!-- 小游戏 tab -->
                <Grid Width="80" Height="32">
                    <Border
                        CornerRadius="8"
                        Background="{DynamicResource WindowBackgroundColor}"
                        IsVisible="{Binding IsGameTabActive}" />
                    <Button
                        Classes="Ghost"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Command="{Binding NavigateTabCommand}"
                        CommandParameter="{x:Static desktop:PageRouteDefine.RouteSessionGame}">
                        <TextBlock Text="小游戏" Classes="Caption" />
                    </Button>
                </Grid>

            </StackPanel>
        </Border>

    </Grid>
</UserControl>
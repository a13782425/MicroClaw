<shadui:Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    xmlns:vm="using:MicroClaw.Desktop"
    mc:Ignorable="d"
    d:DesignWidth="1164"
    d:DesignHeight="768"
    x:Class="MicroClaw.Desktop.Views.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    x:CompileBindings="True"
    Width="1164"
    Height="768"
    MinWidth="980"
    MinHeight="640"
    Background="{DynamicResource WindowBackgroundColor}"
    BorderThickness="0"
    ExtendClientAreaToDecorationsHint="True"
    Icon="/Assets/icon.ico"
    IsTitleBarVisible="False"
    RootCornerRadius="10"
    SaveWindowState="False"
    ShowBottomBorder="False"
    ShowTitlebarBackground="False"
    Title="MicroClaw"
    TitleBarAnimationEnabled="False"
    TransparencyLevelHint="Transparent"
    WindowDecorations="None"
    WindowStartupLocation="CenterScreen">

    <Grid ColumnDefinitions="242,*" ClipToBounds="True">
        <Border
            Grid.Column="0"
            Background="{DynamicResource SidebarBackgroundColor}"
            BorderBrush="{DynamicResource BorderColor30}"
            BorderThickness="0,0,1,0">
            <Grid RowDefinitions="44,*,54">
                <Grid
                    ColumnDefinitions="Auto,*,Auto"
                    Margin="14,0,10,0">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Width="14" Height="14" Padding="0" Background="Transparent" BorderThickness="0" Click="OnCloseClicked">
                            <Ellipse Width="12" Height="12" Fill="#D4D7D3" />
                        </Button>
                        <Button Width="14" Height="14" Padding="0" Background="Transparent" BorderThickness="0" Click="OnMinimizeClicked">
                            <Ellipse Width="12" Height="12" Fill="#D4D7D3" />
                        </Button>
                        <Button Width="14" Height="14" Padding="0" Background="Transparent" BorderThickness="0" Click="OnToggleMaximizeClicked">
                            <Ellipse Width="12" Height="12" Fill="#D4D7D3" />
                        </Button>
                        <PathIcon Data="{x:Static shadui:Icons.SidePanel}" Width="13" Height="13" Foreground="{DynamicResource MutedColor}" Margin="6,0,0,0" />
                    </StackPanel>

                    <Border Grid.Column="1" Background="Transparent" PointerPressed="OnChromePointerPressed" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <PathIcon Data="{x:Static shadui:Icons.ChevronLeft}" Width="12" Height="12" Foreground="{DynamicResource MutedColor}" />
                        <PathIcon Data="{x:Static shadui:Icons.ChevronRight}" Width="12" Height="12" Foreground="{DynamicResource MutedColor}" />
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8,4,8,0" Spacing="2">
                        <Border Background="{DynamicResource SelectionColor}" CornerRadius="6" Padding="8,7">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <PathIcon Data="{x:Static shadui:Icons.SidePanel}" Width="14" Height="14" Foreground="{DynamicResource ForegroundColor}" />
                                <TextBlock Grid.Column="1" Text="Home" Classes="Small" />
                            </Grid>
                        </Border>
                        <Border CornerRadius="6" Padding="8,7">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <PathIcon Data="{x:Static shadui:Icons.Info}" Width="14" Height="14" Foreground="{DynamicResource ForegroundColor}" />
                                <TextBlock Grid.Column="1" Text="Inbox" Classes="Small" />
                            </Grid>
                        </Border>
                        <Border CornerRadius="6" Padding="8,7">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <PathIcon Data="{x:Static shadui:Icons.Calendar}" Width="14" Height="14" Foreground="{DynamicResource ForegroundColor}" />
                                <TextBlock Grid.Column="1" Text="Workflows" Classes="Small" />
                            </Grid>
                        </Border>
                        <Border CornerRadius="6" Padding="8,7">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <PathIcon Data="{x:Static shadui:Icons.Search}" Width="14" Height="14" Foreground="{DynamicResource ForegroundColor}" />
                                <TextBlock Grid.Column="1" Text="Search" Classes="Small" />
                            </Grid>
                        </Border>

                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14" Margin="6,26,6,8">
                            <TextBlock Text="Sessions" Classes="Caption Muted" VerticalAlignment="Center" />
                            <PathIcon Grid.Column="1" Data="{x:Static shadui:Icons.Settings}" Width="13" Height="13" Foreground="{DynamicResource MutedColor}" />
                            <TextBlock Grid.Column="2" Text="+" Classes="Small" Foreground="{DynamicResource MutedColor}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Sessions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SessionPreview">
                                    <Grid Margin="0,1">
                                        <Border Background="{DynamicResource SelectionColor}" CornerRadius="6" IsVisible="{Binding IsActive}" />
                                        <Border Padding="8,6">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                                <PathIcon Data="{x:Static shadui:Icons.ClipBoard}" Width="14" Height="14" Foreground="{DynamicResource ForegroundColor}" Margin="0,2,0,0" />
                                                <StackPanel Grid.Column="1" Spacing="1">
                                                    <TextBlock Text="{Binding Title}" Classes="Small" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Meta}" Classes="Caption Muted" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Border Grid.Column="2" Width="18" Height="18" CornerRadius="5" Background="{DynamicResource SelectionColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" IsVisible="{Binding IsActive}">
                                                    <PathIcon Data="{x:Static shadui:Icons.Check}" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryColor}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="9" Margin="10,0,12,10" VerticalAlignment="Bottom">
                    <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource PrimaryColor}">
                        <TextBlock Text="F" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryForegroundColor}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="Fernanda Sarmento" Classes="Small" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Classes="Icon" Width="26" Height="26" Padding="6" Background="Transparent" Command="{Binding CycleThemeCommand}" ToolTip.Tip="{Binding ThemeButtonToolTip}">
                        <TextBlock Classes="LucideIcon" Text="{Binding ThemeIcon}" FontSize="14" />
                    </Button>
                    <PathIcon Grid.Column="3" Data="{x:Static shadui:Icons.Settings}" Width="14" Height="14" Foreground="{DynamicResource MutedColor}" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="44,*">
            <Border Background="Transparent" PointerPressed="OnChromePointerPressed" />

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                <StackPanel HorizontalAlignment="Center" Margin="0,80,0,32" MaxWidth="668" Spacing="0">
                    <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource MutedColor}" HorizontalAlignment="Center" Margin="0,0,0,34">
                        <PathIcon Data="{x:Static shadui:Icons.Logo}" Width="34" Height="34" Foreground="{DynamicResource WindowBackgroundColor}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <shadui:Card HasShadow="True" Padding="0" CornerRadius="10" Width="668">
                        <StackPanel>
                            <TextBox
                                Text="{Binding DraftPrompt}"
                                AcceptsReturn="True"
                                Background="Transparent"
                                BorderThickness="0"
                                Height="58"
                                Padding="15,13,15,4"
                                PlaceholderText="Ask anything, paste a URL, type / for commands or # to reference issues..."
                                TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="Auto,*,Auto" Height="38" Margin="10,0,8,8">
                                <Button Classes="Ghost" Width="30" Height="30" Padding="0" VerticalAlignment="Center" Content="+" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <Button Classes="Ghost" Padding="8,5">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Text="Interactive" Classes="Caption" />
                                            <PathIcon Data="{x:Static shadui:Icons.ChevronDown}" Width="10" Height="10" Foreground="{DynamicResource MutedColor}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="Ghost" Padding="8,5">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Text="Claude Opus 4.6" Classes="Caption" />
                                            <PathIcon Data="{x:Static shadui:Icons.ChevronDown}" Width="10" Height="10" Foreground="{DynamicResource MutedColor}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="Ghost" Padding="8,5">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Text="Medium" Classes="Caption" />
                                            <PathIcon Data="{x:Static shadui:Icons.ChevronDown}" Width="10" Height="10" Foreground="{DynamicResource MutedColor}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <Button Grid.Column="2" Width="28" Height="28" CornerRadius="14" Padding="7" Background="{DynamicResource MutedColor}" BorderThickness="0" VerticalAlignment="Center">
                                    <PathIcon Data="{x:Static shadui:Icons.ArrowDown}" Width="12" Height="12" Foreground="{DynamicResource WindowBackgroundColor}" RenderTransformOrigin="50%,50%">
                                        <PathIcon.RenderTransform>
                                            <RotateTransform Angle="180" />
                                        </PathIcon.RenderTransform>
                                    </PathIcon>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </shadui:Card>

                    <StackPanel Orientation="Horizontal" Spacing="18" Margin="14,8,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <PathIcon Data="{x:Static shadui:Icons.ClipBoard}" Width="13" Height="13" Foreground="{DynamicResource MutedColor}" />
                            <TextBlock Text="microclaw" Classes="Caption" />
                            <PathIcon Data="{x:Static shadui:Icons.ChevronDown}" Width="10" Height="10" Foreground="{DynamicResource MutedColor}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <PathIcon Data="{x:Static shadui:Icons.Swatch}" Width="13" Height="13" Foreground="{DynamicResource MutedColor}" />
                            <TextBlock Text="New worktree" Classes="Caption" />
                            <PathIcon Data="{x:Static shadui:Icons.ChevronDown}" Width="10" Height="10" Foreground="{DynamicResource MutedColor}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <PathIcon Data="{x:Static shadui:Icons.Marker}" Width="13" Height="13" Foreground="{DynamicResource MutedColor}" />
                            <TextBlock Text="main" Classes="Caption" />
                            <PathIcon Data="{x:Static shadui:Icons.ChevronDown}" Width="10" Height="10" Foreground="{DynamicResource MutedColor}" />
                        </StackPanel>
                    </StackPanel>

                    <Border Width="42" Height="1" Background="{DynamicResource BorderColor}" HorizontalAlignment="Center" Margin="0,32,0,24" />

                    <StackPanel Orientation="Horizontal" Spacing="36" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{x:Static shadui:Icons.ClipBoard}" Width="13" Height="13" Foreground="{DynamicResource ForegroundColor}" />
                            <TextBlock Text="Use local folder or repository" Classes="Caption" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{x:Static shadui:Icons.Logo}" Width="13" Height="13" Foreground="{DynamicResource ForegroundColor}" />
                            <TextBlock Text="Choose from GitHub" Classes="Caption" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{x:Static shadui:Icons.Marker}" Width="13" Height="13" Foreground="{DynamicResource ForegroundColor}" />
                            <TextBlock Text="Clone from URL" Classes="Caption" />
                        </StackPanel>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto" Margin="0,116,0,16">
                        <TextBlock Text="On your radar" FontSize="14" FontWeight="SemiBold" />
                        <Button Grid.Column="1" Classes="Ghost" Content="View inbox" Padding="8,4" />
                    </Grid>

                    <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                        <ItemsControl ItemsSource="{Binding RadarItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RadarItem">
                                    <Border BorderBrush="{DynamicResource BorderColor30}" BorderThickness="0,0,0,1" Padding="14,11">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <Grid Width="12" Height="12" Margin="0,4,0,0">
                                                <Ellipse Stroke="{DynamicResource SuccessColor}" StrokeThickness="2" />
                                                <PathIcon Data="{x:Static shadui:Icons.Check}" Width="7" Height="7" IsVisible="{Binding IsCompleted}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SuccessColor}" />
                                            </Grid>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="{Binding Title}" Classes="Small" />
                                                    <TextBlock Text="{Binding Number}" Classes="Small Muted" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Meta}" Classes="Caption Muted" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Width="6" HorizontalAlignment="Left" Background="Transparent" PointerPressed="OnResizeWestPointerPressed" />
        <Border Width="6" HorizontalAlignment="Right" Background="Transparent" PointerPressed="OnResizeEastPointerPressed" />
        <Border Height="6" VerticalAlignment="Top" Background="Transparent" PointerPressed="OnResizeNorthPointerPressed" />
        <Border Height="6" VerticalAlignment="Bottom" Background="Transparent" PointerPressed="OnResizeSouthPointerPressed" />
        <Border Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" PointerPressed="OnResizeNorthWestPointerPressed" />
        <Border Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" PointerPressed="OnResizeNorthEastPointerPressed" />
        <Border Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" PointerPressed="OnResizeSouthWestPointerPressed" />
        <Border Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" PointerPressed="OnResizeSouthEastPointerPressed" />
    </Grid>
</shadui:Window>
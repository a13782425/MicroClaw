<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
    xmlns:vm="using:MicroClaw.Desktop.ViewModels"
    mc:Ignorable="d"
    d:DesignWidth="668"
    d:DesignHeight="700"
    x:Class="MicroClaw.Desktop.Views.SessionChatTabView"
    x:DataType="vm:SessionChatTabViewModel"
    x:CompileBindings="True">

    <UserControl.Styles>
        <!-- Base bubble (assistant) -->
        <Style Selector="Border.msgBubble">
            <Setter Property="Background" Value="{DynamicResource SecondaryColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <!-- User bubble (right, dark) -->
        <Style Selector="Border.msgBubble.lord">
            <Setter Property="Background" Value="{DynamicResource PrimaryColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryColor}" />
        </Style>
        <Style Selector="Border.msgBubble.lord SelectableTextBlock#BubbleText">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundColor}" />
        </Style>
    </UserControl.Styles>

    <Grid Width="668" HorizontalAlignment="Center" Margin="0,14,0,8" RowDefinitions="Auto,*,Auto">

        <!-- ① 顶部 Logo -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,0,0,14">
            <Border Width="64" Height="64" CornerRadius="17" Background="{DynamicResource PrimaryColor}">
				<Image Source="avares://MicroClaw.Desktop/Assets/Image/Head.png" Stretch="UniformToFill" />
            </Border>
        </StackPanel>

        <!-- ② 消息列表（带卡片边界；消息贴底堆叠，超出才滚动） -->
        <Border Grid.Row="1" CornerRadius="12" Background="{DynamicResource CardBackgroundColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" ClipToBounds="True">
            <ScrollViewer x:Name="MessagesScroll" HorizontalScrollBarVisibility="Disabled" Padding="18,14">
                <Grid MinHeight="{Binding #MessagesScroll.Bounds.Height}">
                    <ItemsControl ItemsSource="{Binding Items}" VerticalAlignment="Bottom">
                        <ItemsControl.DataTemplates>

                            <!-- 日期分割线 -->
                            <DataTemplate x:DataType="vm:ChatDateSeparatorVm">
                                <Border HorizontalAlignment="Center" Margin="0,4,0,14" CornerRadius="999" Background="{DynamicResource SecondaryColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="14,4">
                                    <TextBlock Text="{Binding Label}" Classes="Caption Muted" />
                                </Border>
                            </DataTemplate>

                            <!-- 消息气泡 -->
                            <DataTemplate x:DataType="vm:ChatMessageVm">
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,18" HorizontalAlignment="{Binding RowAlignment}">

                                    <!-- 助手头像 -->
                                    <Border Width="32" Height="32" CornerRadius="16" VerticalAlignment="Top" IsVisible="{Binding ShowAvatar}" Background="{DynamicResource PrimaryColor}">
                                        <PathIcon Data="{x:Static shadui:Icons.Logo}" Width="16" Height="16" Foreground="{DynamicResource PrimaryForegroundColor}" />
                                    </Border>

                                    <Border Classes="msgBubble" Classes.lord="{Binding IsFromUser}" MaxWidth="470">
                                        <StackPanel Spacing="8">

                                            <!-- 思考折叠块（仅助手且有内容时） -->
                                            <StackPanel Spacing="0" IsVisible="{Binding HasThinking}">
                                                <Button Classes="Ghost" Padding="6,3" HorizontalAlignment="Left" Command="{Binding ToggleThinkingCommand}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="✨ 思考过程" Classes="Caption Muted" />
                                                        <TextBlock Text="▾" Classes="Caption Muted" IsVisible="{Binding !IsThinkingExpanded}" />
                                                        <TextBlock Text="▴" Classes="Caption Muted" IsVisible="{Binding IsThinkingExpanded}" />
                                                    </StackPanel>
                                                </Button>
                                                <Border IsVisible="{Binding IsThinkingExpanded}" Margin="0,4,0,0" Padding="10,8" CornerRadius="8" Background="{DynamicResource MutedColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                                    <SelectableTextBlock Text="{Binding Thinking}" TextWrapping="Wrap" Classes="Caption Muted" />
                                                </Border>
                                            </StackPanel>

                                            <!-- 正文 -->
                                            <SelectableTextBlock x:Name="BubbleText" Text="{Binding Text}" TextWrapping="Wrap" IsVisible="{Binding HasText}" />

                                            <!-- 附件列表 -->
                                            <ItemsControl ItemsSource="{Binding Attachments}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Spacing="6" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ChatAttachmentVm">
                                                        <Border Padding="10,8" CornerRadius="8" Background="{DynamicResource CardBackgroundColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Icon}" FontSize="20" VerticalAlignment="Center" />
                                                                <StackPanel Spacing="2">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundColor}" />
                                                                    <TextBlock Text="{Binding SizeText}" Classes="Caption Muted" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- 时间戳（悬浮显示完整时间） -->
                                            <TextBlock Text="{Binding Time}" ToolTip.Tip="{Binding TimeTooltip}" Classes="Caption Muted" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>

                        </ItemsControl.DataTemplates>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- ③ 输入区 -->
        <shadui:Card Grid.Row="2" HasShadow="True" Padding="0" CornerRadius="10" Margin="0,10,0,0">
            <StackPanel>

                <!-- 待发送附件预览条 -->
                <Border IsVisible="{Binding HasPendingAttachments}" Padding="12,10,12,4" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
                    <ItemsControl ItemsSource="{Binding PendingAttachments}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChatAttachmentVm">
                                <Border Margin="0,0,6,6" Padding="8,5" CornerRadius="8" Background="{DynamicResource SecondaryColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Icon}" FontSize="15" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" MaxWidth="160" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SizeText}" Classes="Caption Muted" VerticalAlignment="Center" />
                                        <Button
                                            Classes="Ghost"
                                            Width="18" Height="18" Padding="0"
                                            VerticalAlignment="Center"
                                            Content="✕"
                                            FontSize="11"
                                            Command="{Binding $parent[ItemsControl].((vm:SessionChatTabViewModel)DataContext).RemovePendingAttachmentCommand}"
                                            CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- 文本输入行 -->
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="8,8,8,8" ColumnSpacing="6">
                    <Button x:Name="AttachButton" Grid.Column="0" Classes="Ghost" Width="36" Height="36" Padding="0" VerticalAlignment="Bottom" Content="📎" ToolTip.Tip="添加附件（图片 / 视频 / 音频 / 文档）" />
                    <TextBox
                        x:Name="PromptBox"
                        Grid.Column="1"
                        Text="{Binding DraftPrompt}"
                        AcceptsReturn="True"
                        MinHeight="40"
                        MaxHeight="120"
                        VerticalContentAlignment="Center"
                        PlaceholderText="输入传音内容……（Enter 发送，Shift+Enter 换行）"
                        TextWrapping="Wrap" />
                    <Button
                        Grid.Column="2"
                        Classes="Primary"
                        Width="36" Height="36"
                        CornerRadius="8"
                        Padding="0"
                        VerticalAlignment="Bottom"
                        Content="➤"
                        Command="{Binding SendCommand}" />
                </Grid>
            </StackPanel>
        </shadui:Card>
    </Grid>

</UserControl>
